# BAKO — Variables de entorno
# Copia este archivo como .env y rellena los valores
# Las variables marcadas con [RENDER] también deben configurarse en el dashboard de Render

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/ai-personal-os
# Local: mongodb://localhost:27017/ai-personal-os
MONGODB_URI=
DBUSERNAME=
DBPASSWORD=

# ─── BAKO ────────────────────────────────────────────────────────────────────
BAKO_OWNER_NAME=Borja

# ─── Telegram ────────────────────────────────────────────────────────────────
# Obtener: @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Obtener: enviar cualquier mensaje al bot → https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# ─── GitHub ──────────────────────────────────────────────────────────────────
# Obtener: github.com → Settings → Developer Settings → PAT (classic) → scope: repo
GITHUB_TOKEN=
GITHUB_USERNAME=bohdeveloper

# ─── LLM — Groq (fallback cloud) ─────────────────────────────────────────────
# Obtener: console.groq.com → API Keys → Create API Key
# AVISO: límite diario por CUENTA (no por clave). Nueva clave = mismo límite.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# ─── LLM — Ollama (local) ────────────────────────────────────────────────────
# Expuesto via Cloudflare Tunnel desde el PC de casa. Si responde, es el LLM por
# defecto (no gasta cuota de Groq); si no, se usa Groq automaticamente.
# Sin definir OLLAMA_URL → siempre Groq.
# OLLAMA_URL=https://ollama.bohdeveloper.com
# Con la AMD RX 7600 de 8 GB (ROCm) qwen3:8b entra entero en la GPU: 0,6 s con el
# modelo caliente, 14,8 s si hay que cargarlo (medido con un prompt de 7.695 tokens).
# OLLAMA_MODEL=qwen3:8b
# No subir NUM_CTX a 12288+: en esta GPU la generacion cae de 37,5 a 5,4 tokens/s.
# OLLAMA_NUM_CTX=8192
# Por encima de la carga en frio (14,8 s) y por debajo del safety de 25 s.
# OLLAMA_TIMEOUT_MS=18000
# Cuanto sigue el modelo residente en VRAM tras responder (~7 GB ocupados en el PC).
# OLLAMA_KEEP_ALIVE=30m
# ¿Ollama es el LLM por defecto? true = local primero, Groq como respaldo.
# LLM_PREFER_LOCAL=true
# Secreto compartido con la regla WAF de Cloudflare que protege el tunel: el
# backend manda `x-bako-key` y Cloudflare bloquea lo que no la lleve. En local
# no hace falta (se habla con localhost:11434, sin pasar por Cloudflare).
# OLLAMA_AUTH_KEY=

# ─── Voz TTS ─────────────────────────────────────────────────────────────────
# La voz real vive en Mongo (AutoConfig, key tts_voice) y se cambia con /voz en
# Telegram o el selector de la PWA/Desktop. Esto solo es el defecto de arranque,
# antes de que exista nada guardado. Únicas 3 voces neuronales es-ES de Microsoft:
# alvaro (hombre), elvira (mujer), ximena (mujer).
TTS_VOICE_KEY=alvaro

# ─── Clima (Open-Meteo, sin API key) ─────────────────────────────────────────
WEATHER_LAT=43.3108
WEATHER_LON=-1.8997
WEATHER_CITY=Errenteria

# ─── Notion ──────────────────────────────────────────────────────────────────
# Token: notion.so/my-integrations → New integration → Internal Integration Secret
NOTION_TOKEN=
# IDs: URL de cada base de datos → https://notion.so/<ID>?v=...
# Bases "Tareas" y "Proyectos" de la página Centro de Mando.
# La integración debe estar conectada a esa página (••• → Conexiones).
NOTION_TASKS_DB_ID=
NOTION_PROJECTS_DB_ID=

# ─── Cloudflare Workers AI ───────────────────────────────────────────────────
# Solo para embeddings (fallback cuando Ollama no está disponible).
# BAKO ya no accede a la base D1 de bohdeveloper.com.
# Token: dash.cloudflare.com/profile/api-tokens → bako-token
# Si no está visible: rotar el token existente (Roll) desde el dashboard
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=8797ca273053599f8c9ba20db1df4095

# ─── Google Calendar ─────────────────────────────────────────────────────────
# Obtener credentials: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client
# ESTE FICHERO ESTÁ EN GIT Y EL REPOSITORIO ES PÚBLICO: solo placeholders, nunca valores reales.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcion A — Inline JSON (recomendado para trabajo y Render) [RENDER]
# Pegar el contenido completo de token.json en una sola linea
# El token se auto-renueva via refresh_token, no caduca salvo que se revoque
GOOGLE_TOKEN_JSON=

# Opcion B — Archivos locales (solo PC de casa con los archivos descargados)
# GOOGLE_CREDENTIALS_PATH=./credentials.json
# GOOGLE_TOKEN_PATH=./token.json
